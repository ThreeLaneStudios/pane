  <note>
    <title>Welcome to Trove</title>
    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note>
<h1>Welcome to Trove</h1>
<p>This is a <b>test note</b> with <i>various</i> formatting.</p>
<h2>Features</h2>
<ul>
<li>Bullet point one</li>
<li>Bullet point two</li>
<li>Bullet point three</li>
</ul>
<h3>A Checklist</h3>
<div><en-todo checked="true"/>Buy milk</div>
<div><en-todo checked="false"/>Write documentation</div>
<div><en-todo checked="true"/>Ship the product</div>
<h2>Code Example</h2>
<pre><code>const trove = new Trove();
trove.importNotes('evernote.enex');
console.log('Done!');</code></pre>
<p>Here is a <a href="https://example.com">link to example.com</a>.</p>
<hr/>
<p>And a horizontal rule above.</p>
<blockquote>This is a blockquote with some wisdom.</blockquote>
<h2>A Table</h2>
<table>
<tr><th>Feature</th><th>Status</th></tr>
<tr><td>Editor</td><td>✅ Done</td></tr>
<tr><td>Search</td><td>🔧 In Progress</td></tr>
<tr><td>Import</td><td>📋 Planned</td></tr>
</table>
</en-note>]]></content>
