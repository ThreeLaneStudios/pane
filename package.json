    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "2.10.0",
    "@testing-library/svelte": "^4.1.0",
    "@types/dompurify": "^3.2.0",
    "jsdom": "^24.0.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
