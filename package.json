{
  "name": "pane",
  "private": true,
  "version": "1.0.87",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:e2e": "npx playwright test",
    "test:all": "cargo test --manifest-path src-tauri/Cargo.toml && npm run test && npm run test:e2e",
    "prebuild": "bash scripts/pre-build.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
