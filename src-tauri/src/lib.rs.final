// Pane v10.1.1 — Main Library
// Architecture per pane-architecture-spec.md

mod database;
mod dashboard;
mod notes;
mod projects;
mod tags;
mod sync;
mod ai;

use database::DbState;
use sync::commands::{SyncManagerState, AutoSyncState};
use sync::manager::SyncManager;
use sync::auto_sync::AutoSync;
use ai::commands::AiStateWrapper;
use ai::commands::AiConfig;
use ai::provider::AiProvider;
use std::sync::{Arc, Mutex};
use tauri::Manager;

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        .plugin(tauri_plugin_dialog::init())
        .plugin(tauri_plugin_shell::init())
        .setup(|app| {
            // Resolve crsqlite.dylib resource path
            let crsqlite_path = app.path().resource_dir()
                .ok()
                .map(|dir| dir.join("resources/crsqlite.dylib"));
            
            // Initialize database with cr-sqlite extension
            let conn = database::init_database(crsqlite_path)
                .map_err(|e| format!("Failed to initialize database: {}", e))?;
            
            app.manage(DbState(std::sync::Mutex::new(conn)));
            
            // Initialize sync manager state
            app.manage(SyncManagerState(Arc::new(Mutex::new(SyncManager::new()))));
            
            // Initialize auto-sync state
            app.manage(AutoSyncState(Arc::new(AutoSync::new())));
            
            // Initialize AI state
            let ai_state = AiStateWrapper(Mutex::new(AiConfig {
                provider: AiProvider::None,
                model: String::new(),
                system_prompt: String::from("You are Pane, an AI partner embedded in a notes and project management app. You help the user organize their work, create and manage notes and tasks, and think through problems. Be concise, helpful, and proactive. You have access to the user's workspace context shown below."),
            }));
            
            // Auto-configure AI from saved settings
            let db_for_ai = app.state::<DbState>();
            if let Ok(conn) = db_for_ai.0.lock() {
                let get = |key: &str| -> Option<String> {
                    conn.query_row("SELECT value FROM ai_settings WHERE key = ?1", [key], |row| row.get(0)).ok()
                };
                
                let provider = get("provider").unwrap_or_default();
                let api_key = get("api_key");
                let model = get("model");
                let endpoint = get("endpoint");
                
                if let Ok(mut state) = ai_state.0.lock() {
                    match provider.as_str() {
                        "anthropic" => {
                            if let Some(key) = api_key {
                                state.provider = AiProvider::Anthropic { api_key: key };
                                state.model = model.unwrap_or("claude-sonnet-4-20250514".to_string());
                                println!("[ai] Auto-configured Anthropic with model: {}", state.model);
                            }
                        }
                        "openrouter" => {
                            if let Some(key) = api_key {
                                state.provider = AiProvider::OpenRouter { api_key: key };
                                state.model = model.unwrap_or("anthropic/claude-sonnet-4".to_string());
                                println!("[ai] Auto-configured OpenRouter with model: {}", state.model);
                            }
                        }
                        "ollama" => {
                            state.provider = AiProvider::Ollama {
                                endpoint: endpoint.unwrap_or("http://localhost:11434".to_string()),
                            };
                            state.model = model.unwrap_or("llama3.2:8b".to_string());
                            println!("[ai] Auto-configured Ollama with model: {}", state.model);
                        }
                        _ => {
                            println!("[ai] No provider configured or unknown provider: {}", provider);
                        }
                    }
                }
            }
            
            app.manage(ai_state);
            
            println!("✓ Pane v10.1.1 initialized");
            println!("✓ Database: ~/Pane/.pane/pane.db");
            println!("✓ Projects: ~/Pane/Projects/");
            
            Ok(())
        })
        .invoke_handler(tauri::generate_handler![
            // Note CRUD (§17.1)
            notes::create_note,
            notes::get_note,
            notes::get_notes,
            notes::get_tasks,
            notes::list_upcoming_tasks,
            notes::search_notes,
            notes::update_note,
            notes::delete_note,
            notes::restore_note,
            notes::purge_note,
            notes::get_trash,
            notes::empty_trash,
            notes::reorder_notes,
            notes::get_subtasks,
            notes::rebuild_index,
            notes::get_project_note_counts,
            
            // Settings Stubs (v9.0.12)
            notes::check_openclaw_status,
            notes::get_ai_setting,
            notes::set_ai_setting,
            notes::ai_save_config,
            notes::ai_load_config,
            notes::get_chat_message_count,
            notes::get_chat_memory,
            notes::save_chat_memory,
            notes::delete_old_chat_messages,
            notes::get_vault_path_setting,
            notes::set_vault_path_setting,
            
            // Project/Folder CRUD (§17.2)
            projects::create_project,
            projects::get_projects,
            projects::update_project,
            projects::delete_project,
            projects::create_folder,
            projects::get_folders,
            projects::update_folder,
            projects::delete_folder,
            projects::list_categories,
            projects::set_project_category,
            projects::set_category_color,
            projects::delete_category,
            
            // Tag Management (§17.3)
            tags::get_tags,
            tags::create_tag,
            tags::update_tag,
            tags::delete_tag,
            tags::add_note_tags,
            tags::remove_note_tags,
            tags::get_notes_by_tag,
            
            // Dashboard (v9.0.2)
            dashboard::get_dashboard_modules,
            dashboard::get_dashboard_config,
            dashboard::create_dashboard_module,
            dashboard::update_dashboard_module,
            dashboard::update_module_content_cmd,
            dashboard::delete_dashboard_module,
            dashboard::toggle_dashboard_module,
            dashboard::reorder_dashboard_modules,
            dashboard::get_module_items_cmd,
            dashboard::create_module_item_cmd,
            dashboard::update_module_item_cmd,
            dashboard::delete_module_item_cmd,
            dashboard::get_daily_entries_cmd,
            dashboard::save_daily_entry_cmd,
            dashboard::get_habit_entries_cmd,
            dashboard::save_habit_entry_cmd,
            dashboard::get_reflection_entries_cmd,
            dashboard::save_reflection_entry_cmd,
            dashboard::get_gratitude_entries_cmd,
            dashboard::save_gratitude_entry_cmd,
            dashboard::delete_gratitude_entry_cmd,
            dashboard::get_home_state,
            dashboard::save_home_state,
            
            // Sync status (v9.1.0)
            database::get_sync_status,
            
            // Auth & Device Registration (v9.1.2)
            sync::commands::auth_sign_up,
            sync::commands::auth_sign_in,
            sync::commands::auth_sign_out,
            sync::commands::auth_refresh,
            sync::commands::register_device_cmd,
            sync::commands::get_auth_session,
            sync::commands::save_auth_session,
            sync::commands::clear_auth_session,
            sync::commands::get_hostname,
            sync::commands::init_encryption,
            sync::commands::is_encryption_ready,
            sync::commands::clear_encryption,
            sync::commands::test_encryption,
            
            // Sync Engine (v9.1.3)
            sync::commands::sync_push,
            sync::commands::sync_pull,
            sync::commands::sync_configure,
            sync::commands::get_sync_info,
            sync::commands::sync_files_push,
            sync::commands::sync_files_pull,
            
            // Auto-sync (v9.2.7)
            sync::commands::start_auto_sync,
            sync::commands::stop_auto_sync,
            sync::commands::notify_sync_change,
            
            // AI Provider (v9.3.0)
            ai::commands::ai_configure,
            ai::commands::ai_chat,
            ai::commands::ai_check_ollama,
            ai::commands::ai_get_config,
            
            // AI Chat Thread/Message Management (v9.3.1)
            ai::commands::get_or_create_thread,
            ai::commands::get_chat_messages,
            ai::commands::send_chat_message,
            ai::commands::delete_chat_messages,
        ])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}
